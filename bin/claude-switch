#!/usr/bin/env bash
# claude-switch: swap Claude Code subscription accounts on macOS.
# Saved logins live in the login Keychain. Usage comes from the status line
# JSON that Claude Code already provides, so this tool never calls an API.
set -euo pipefail

VERSION="0.1.0"
CC_SERVICE="Claude Code-credentials"
STORE_SERVICE="claude-switch"
KC_ACCOUNT="${USER:-$(id -un)}"
DIR="${CLAUDE_SWITCH_DIR:-$HOME/.claude-switch}"
STATE="$DIR/state.json"
LOCK="$DIR/lock"
LOG="$DIR/log"
CLAUDE_JSON="$HOME/.claude.json"
CREDS_FILE="$HOME/.claude/.credentials.json"
USAGE_URL="${CLAUDE_SWITCH_USAGE_URL:-https://api.anthropic.com/api/oauth/usage}"
# Keychain keys that belong to a login. Everything else (mcpOAuth, ...) stays.
LOGIN_KEYS='["claudeAiOauth","organizationUuid","trustedDeviceToken","enterpriseGateway"]'

die() { echo "claude-switch: $*" >&2; exit 1; }
log() { mkdir -p "$DIR"; echo "$(date '+%F %T') $*" >>"$LOG"; }
notify() {
  log "notify: $1"
  osascript -e "display notification \"$1\" with title \"claude-switch\"" >/dev/null 2>&1 || true
}

# --- keychain ---------------------------------------------------------------

kc_read() { security find-generic-password -s "$1" -a "$2" -w 2>/dev/null; }

kc_write() {
  security add-generic-password -U -s "$1" -a "$2" -w "$3" >/dev/null \
    || die "could not write keychain item $1/$2"
  [ "$(kc_read "$1" "$2")" = "$3" ] || die "keychain write to $1/$2 did not verify"
}

# --- state ------------------------------------------------------------------

state_init() {
  mkdir -p "$DIR"
  chmod 700 "$DIR"
  [ -f "$STATE" ] || echo '{"active":null,"order":[],"accounts":{},"usage":{},"sessions":{}}' >"$STATE"
}

# state_update <jq filter> [jq args...]
state_update() {
  local filter=$1 tmp
  shift
  tmp=$(mktemp "$DIR/.state.XXXXXX")
  jq "$@" "$filter" "$STATE" >"$tmp" && mv "$tmp" "$STATE"
}

state_get() { jq -r "$@" "$STATE"; }

lock() {
  local i=0
  until mkdir "$LOCK" 2>/dev/null; do
    if [ $((i++)) -gt 50 ]; then
      if [ $(($(date +%s) - $(stat -f %m "$LOCK"))) -gt 60 ]; then
        rmdir "$LOCK" 2>/dev/null || true
      else
        die "another switch is in progress"
      fi
    fi
    sleep 0.2
  done
  trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
}

unlock() { rmdir "$LOCK" 2>/dev/null || true; trap - EXIT; }

# --- accounts ---------------------------------------------------------------

live_email() { jq -r '.oauthAccount.emailAddress // empty' "$CLAUDE_JSON" 2>/dev/null; }

# Store a login (Keychain JSON) and its oauthAccount as profile <name>.
save_profile() {
  local name=$1 live=$2 acct=$3 email=$4 profile rt_exp
  # Secrets go through stdin, never argv.
  profile=$(printf '%s' "$live" | jq -c --argjson acct "$acct" --argjson keys "$LOGIN_KEYS" \
    '{login: with_entries(select(.key as $k | $keys | index($k))), oauthAccount: $acct}')
  rt_exp=$(printf '%s' "$live" | jq '.claudeAiOauth.refreshTokenExpiresAt // null')
  kc_write "$STORE_SERVICE" "$name" "$profile"
  state_update '.accounts[$n] = {email: $e, rt_exp: $r} | .order |= (if index($n) then . else . + [$n] end)' \
    --arg n "$name" --arg e "$email" --argjson r "$rt_exp"
}

# Copy the live login into profile <name>.
snapshot() {
  local name=$1 live acct email
  live=$(kc_read "$CC_SERVICE" "$KC_ACCOUNT") || die "no Claude Code login found in the Keychain"
  acct=$(jq -c '.oauthAccount // null' "$CLAUDE_JSON")
  email=$(jq -r '.emailAddress // empty' <<<"$acct")
  [ -n "$email" ] || email=$(state_get --arg n "$name" '.accounts[$n].email // empty')
  [ -n "$email" ] || die "no oauthAccount in $CLAUDE_JSON; run 'claude' once after logging in"
  save_profile "$name" "$live" "$acct" "$email"
}

account_for_email() {
  state_get --arg e "$1" '[.accounts | to_entries[] | select(.value.email == $e) | .key][0] // empty'
}

# Save the live login before replacing it, since Claude Code rotates its tokens.
snapshot_active() {
  local live name
  live=$(live_email)
  if [ -n "$live" ]; then
    name=$(account_for_email "$live")
    [ -n "$name" ] || die "you are logged in as '$live', which is not saved. Save it first: claude-switch add <name>"
  else
    name=$(state_get '.active // empty')
    [ -n "$name" ] || return 0
  fi
  snapshot "$name"
}

kc_services() {
  security dump-keychain 2>/dev/null \
    | sed -n 's/.*"svce"<blob>="\(Claude Code-credentials-[^"]*\)".*/\1/p' | sort -u
}

# Log in inside a throwaway config dir and save the result as <name>.
# Claude Code keys its Keychain item by config dir, so the live login and every
# running session stay untouched.
isolated_login() {
  local name=$1 expected=${2:-} tmp before svc live="" acct email other main_before stray
  tmp=$(mktemp -d "$DIR/login.XXXXXX")
  before=$(kc_services)
  main_before=$(kc_read "$CC_SERVICE" "$KC_ACCOUNT" || true)
  if [ -n "$expected" ]; then
    CLAUDE_CONFIG_DIR="$tmp" claude auth login --email "$expected" || { rm -rf "$tmp"; die "login failed"; }
  else
    CLAUDE_CONFIG_DIR="$tmp" claude auth login || { rm -rf "$tmp"; die "login failed"; }
  fi
  sleep 1
  # Safety net: if this Claude Code version wrote the main item anyway, put it back.
  stray=$(kc_read "$CC_SERVICE" "$KC_ACCOUNT" || true)
  if [ -n "$main_before" ] && [ "$stray" != "$main_before" ]; then
    live=$stray
    kc_write "$CC_SERVICE" "$KC_ACCOUNT" "$main_before"
    echo "claude-switch: login touched the main Keychain item; restored it" >&2
    log "isolated login touched main item; restored"
  fi
  svc=$(comm -13 <(printf '%s\n' "$before") <(kc_services) | head -1)
  if [ -n "$svc" ]; then
    live=$(security find-generic-password -s "$svc" -w 2>/dev/null) || live=""
  elif [ -f "$tmp/.credentials.json" ]; then
    live=$(cat "$tmp/.credentials.json")
  fi
  acct=$(jq -c '.oauthAccount // null' "$tmp/.claude.json" 2>/dev/null || echo null)
  email=$(jq -r '.emailAddress // empty' <<<"$acct")
  [ -n "$email" ] || email=$(CLAUDE_CONFIG_DIR="$tmp" claude auth status --json 2>/dev/null | jq -r '.email // empty')
  [ -z "$svc" ] || security delete-generic-password -s "$svc" >/dev/null 2>&1 || true
  rm -rf "$tmp"
  [ -n "$live" ] || die "login did not produce credentials"
  [ -n "$email" ] || die "could not tell which account logged in"
  [ -z "$expected" ] || [ "$email" = "$expected" ] || die "logged in as '$email', expected '$expected'"
  other=$(account_for_email "$email")
  [ -z "$other" ] || [ "$other" = "$name" ] || die "'$email' is already saved as '$other'"
  lock
  save_profile "$name" "$live" "$acct" "$email"
  unlock
  echo "saved '$name' ($email)"
}

# Put saved profile <name> into Claude Code's Keychain item and ~/.claude.json.
restore() {
  local name=$1 profile live merged acct tmp try
  profile=$(kc_read "$STORE_SERVICE" "$name") || die "no saved account '$name'"
  live=$(kc_read "$CC_SERVICE" "$KC_ACCOUNT" || echo '{}')
  merged=$(printf '%s\n%s' "$live" "$profile" | jq -cs --argjson keys "$LOGIN_KEYS" \
    '(.[0] | with_entries(select(.key as $k | $keys | index($k) | not))) + .[1].login')
  acct=$(printf '%s' "$profile" | jq -c '.oauthAccount')
  # Keychain first, then the files: a running session re-reads the Keychain
  # when the credentials file mtime changes.
  kc_write "$CC_SERVICE" "$KC_ACCOUNT" "$merged"
  for try in 1 2 3; do
    tmp=$(mktemp "$HOME/.claude.json.XXXXXX")
    # A null oauthAccount is dropped; Claude Code derives it from the token.
    if jq --argjson a "$acct" 'if $a == null then del(.oauthAccount) else .oauthAccount = $a end' \
      "$CLAUDE_JSON" >"$tmp" 2>/dev/null; then
      mv "$tmp" "$CLAUDE_JSON"
      break
    fi
    rm -f "$tmp"
    [ "$try" = 3 ] && die "could not update $CLAUDE_JSON"
    sleep 0.5 # Claude Code may be mid-write
  done
  [ -f "$CREDS_FILE" ] && touch "$CREDS_FILE"
  state_update '.active = $n | .last_switch = now' --arg n "$name"
}

# Exit 0 when the saved refresh token is known to have expired.
is_dead() {
  state_get --arg n "$1" '(.accounts[$n].rt_exp // null) as $r | $r != null and $r / 1000 < now' | grep -qx true
}

is_exhausted() {
  state_get --arg n "$1" --argjson t "$THRESHOLD" '
    (.usage[$n] // {}) as $u
    | ((($u.five // 0) >= $t and ($u.five_reset // 0) > now)
       or (($u.seven // 0) >= $t and ($u.seven_reset // 0) > now))' | grep -qx true
}

require_account() {
  [ "$(state_get --arg n "$1" '.accounts[$n] != null')" = true ] || die "unknown account '$1'. See: claude-switch list"
}

# Read usage for a saved, inactive account with its saved access token.
# Never refreshes: an expired token returns 2 and the last known numbers stay.
# Identifies itself honestly as claude-switch.
fetch_usage() {
  local name=$1 profile token body code usage
  profile=$(kc_read "$STORE_SERVICE" "$name") || return 1
  [ "$(printf '%s' "$profile" | jq '(.login.claudeAiOauth.expiresAt // 0) / 1000 > now + 60')" = true ] || return 2
  token=$(printf '%s' "$profile" | jq -r '.login.claudeAiOauth.accessToken // empty')
  [ -n "$token" ] || return 1
  # The header goes through stdin (printf is a builtin), so the token never hits argv.
  body=$(printf 'Authorization: Bearer %s\n' "$token" | curl -sS -m 10 -w '\n%{http_code}' -H @- \
    -H 'anthropic-beta: oauth-2025-04-20' -H "User-Agent: claude-switch/$VERSION" \
    "$USAGE_URL" 2>/dev/null) || { log "usage $name: request failed"; return 1; }
  code=${body##*$'\n'}
  body=${body%$'\n'*}
  [ "$code" = 200 ] || { log "usage $name: HTTP $code"; return 1; }
  usage=$(jq -c '
    def epoch: if . == null then null else sub("\\.[0-9]+"; "") | sub("[+]00:00$"; "Z") | fromdateiso8601 end;
    {five: .five_hour.utilization, five_reset: (.five_hour.resets_at | epoch),
     seven: .seven_day.utilization, seven_reset: (.seven_day.resets_at | epoch), at: now, src: "api"}' \
    <<<"$body") || { log "usage $name: unexpected response"; return 1; }
  lock
  state_update '.usage[$n] = $u' --arg n "$name" --argjson u "$usage"
  unlock
}

# --- commands ---------------------------------------------------------------

cmd_add() {
  local name=${1:-} flag=${2:-} live existing
  [ -n "$name" ] || die "usage: claude-switch add <name> [--login]"
  existing=$(state_get --arg n "$name" '.accounts[$n].email // empty')
  if [ "$flag" = --login ]; then
    [ -z "$existing" ] || die "'$name' already exists ($existing)"
    isolated_login "$name"
    return
  fi
  live=$(live_email)
  [ -n "$live" ] || die "no oauthAccount in $CLAUDE_JSON; run 'claude' once after logging in"
  [ -z "$existing" ] || [ "$existing" = "$live" ] \
    || die "'$name' is '$existing' but you are logged in as '$live'"
  lock
  snapshot "$name"
  state_update '.active = $n' --arg n "$name"
  echo "saved '$name' ($live) and marked it active"
}

cmd_use() {
  local name=${1:-} auto=${2:-}
  [ -n "$name" ] || die "usage: claude-switch use <name>"
  require_account "$name"
  [ "$(state_get '.active // empty')" != "$name" ] || { echo "already on '$name'"; return 0; }
  if is_dead "$name"; then
    if [ "$auto" = auto ]; then
      notify "'$name' needs a new login: claude-switch login $name"
      return 1
    fi
    echo "'$name' refresh token expired, logging in again"
    cmd_login "$name"
  fi
  lock
  snapshot_active
  restore "$name"
  unlock
  log "switched to $name"
  echo "now on '$name' ($(state_get --arg n "$name" '.accounts[$n].email'))"
}

cmd_next() {
  local auto=${1:-} active name candidates
  active=$(state_get '.active // empty')
  # Accounts after the active one, wrapping around.
  candidates=$(state_get --arg a "$active" '.order as $o | ($o | index($a) // -1) as $i | ($o[$i+1:] + $o[:$i+1])[] | select(. != $a)')
  for name in $candidates; do
    is_exhausted "$name" && continue
    if [ "$auto" = auto ] && is_dead "$name"; then
      notify "'$name' needs a new login: claude-switch login $name"
      continue
    fi
    cmd_use "$name" "$auto" && return 0
  done
  if [ "$auto" = auto ]; then notify "every account is at its limit; staying on '$active'"; fi
  die "no other account available"
}

cmd_login() {
  local name=${1:-} email
  [ -n "$name" ] || die "usage: claude-switch login <name>"
  require_account "$name"
  email=$(state_get --arg n "$name" '.accounts[$n].email')
  isolated_login "$name" "$email"
  # Refresh the live login too when this is the account in use.
  if [ "$(live_email)" = "$email" ]; then
    lock
    restore "$name"
    unlock
  fi
}

# Called from the status line with its JSON on stdin.
cmd_report() {
  local input out
  input=$(cat)
  [ "$(state_get '.active // empty')" ] || return 0
  lock
  # Ignore repeats: a session shows its last response's numbers until the next
  # response, which right after a switch still belong to the old account.
  out=$(jq -c --argjson in "$input" --argjson t "$THRESHOLD" '
    ($in.rate_limits // {}) as $r
    | if $r.five_hour == null then {state: ., switch: false}
      else
        ($r.five_hour.used_percentage // 0) as $f
        | ($r.seven_day.used_percentage // 0) as $w
        | "\($f)|\($r.five_hour.resets_at)|\($w)|\($r.seven_day.resets_at)" as $sig
        | ($in.session_id // "none") as $sid
        | if .sessions[$sid].sig == $sig then {state: ., switch: false}
          else
            .sessions[$sid] = {sig: $sig, at: now}
            | .sessions |= with_entries(select(.value.at > now - 86400))
            | .usage[.active] = {five: $f, five_reset: $r.five_hour.resets_at,
                                 seven: $w, seven_reset: $r.seven_day.resets_at, at: now}
            | {state: ., switch: ($f >= $t or $w >= $t)}
          end
      end' "$STATE")
  state_update '$o.state' --argjson o "$out"
  unlock
  if [ "$(jq -r '.switch' <<<"$out")" = true ]; then
    log "limit reached on $(state_get '.active')"
    cmd_next auto
  fi
}

# "4h 12m", "2d 3h"
human_in() {
  local s=$(($1 - $(date +%s)))
  if [ "$s" -ge 86400 ]; then echo "$((s / 86400))d $((s % 86400 / 3600))h"
  elif [ "$s" -ge 3600 ]; then echo "$((s / 3600))h $((s % 3600 / 60))m"
  else echo "$((s / 60 + 1))m"; fi
}

human_ago() {
  local s=$(($(date +%s) - $1))
  if [ "$s" -lt 60 ]; then echo "just now"
  elif [ "$s" -lt 3600 ]; then echo "$((s / 60))m ago"
  elif [ "$s" -lt 86400 ]; then echo "$((s / 3600))h ago"
  else echo "$((s / 86400))d ago"; fi
}

# meter <percent|empty> <reset epoch|empty>
meter() {
  local p=${1:-} r=${2:-} n i bar="" color
  if [ -z "$p" ]; then printf '%s%-34s%s' "$DIM" "no data yet" "$RESET"; return; fi
  n=$(((p + 5) / 10))
  for ((i = 0; i < 10; i++)); do if [ "$i" -lt "$n" ]; then bar+="█"; else bar+="░"; fi; done
  if [ "$p" -ge "$THRESHOLD" ]; then color=$RED; elif [ "$p" -ge 75 ]; then color=$YELLOW; else color=$GREEN; fi
  printf '%s%s %3d%%%s  %sresets in %-7s%s' "$color" "$bar" "$p" "$RESET" "$DIM" "$(human_in "$r")" "$RESET"
}

cmd_list() {
  local active name email five five_r seven seven_r dead at mark
  # The active account's usage comes from the status line. Inactive ones are
  # read here, once per list, while their saved token is still valid.
  for name in $(state_get '.active as $a | .order[] | select(. != $a)'); do
    fetch_usage "$name" || true
  done
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\e[1m' DIM=$'\e[2m' RED=$'\e[31m' YELLOW=$'\e[33m' GREEN=$'\e[32m' RESET=$'\e[0m'
  else
    BOLD="" DIM="" RED="" YELLOW="" GREEN="" RESET=""
  fi
  [ "$(state_get '.order | length')" -gt 0 ] || { echo "no accounts yet. Run: claude-switch add <name>"; return; }
  printf '%s  %-12s %-34s %-37s %-37s %s%s\n' "$DIM" ACCOUNT EMAIL "SESSION (5h)" "WEEKLY (7d)" UPDATED "$RESET"
  # Windows whose reset time has passed show as no data.
  while IFS='|' read -r active name email five five_r seven seven_r dead at; do
    mark="  "
    [ "$active" = true ] && mark="${GREEN}●${RESET} "
    printf '%s%s%-12s%s %-34s %s   %s' "$mark" "$BOLD" "$name" "$RESET" "$email" \
      "$(meter "$five" "$five_r")" "$(meter "$seven" "$seven_r")"
    [ -n "$at" ] && printf '   %s%s%s' "$DIM" "$(human_ago "$at")" "$RESET"
    [ "$dead" = true ] && printf '  %sLOGIN NEEDED: claude-switch login %s%s' "$RED" "$name" "$RESET"
    printf '\n'
  done < <(state_get '
    .active as $a | .usage as $u | .accounts as $acc
    | .order[] as $n
    | ($u[$n] // {}) as $x
    | def live($v; $r): if $v == null or ($r // 0) < now then "" else ($v | floor | tostring) end;
      def at($v; $r): if $v == null or ($r // 0) < now then "" else ($r | tostring) end;
      [($n == $a | tostring), $n, $acc[$n].email,
       live($x.five; $x.five_reset), at($x.five; $x.five_reset),
       live($x.seven; $x.seven_reset), at($x.seven; $x.seven_reset),
       ((($acc[$n].rt_exp // null) != null and $acc[$n].rt_exp / 1000 < now) | tostring),
       ($x.at // "" | if . == "" then "" else floor | tostring end)]
    | join("|")')
  printf '\n%sswitches automatically at %s%% of either window%s\n' "$DIM" "$THRESHOLD" "$RESET"
}

cmd_threshold() {
  local n=${1:-}
  if [ -z "$n" ]; then echo "$THRESHOLD"; return; fi
  [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le 100 ] || die "threshold must be 1-100"
  state_update '.threshold = $t' --argjson t "$n"
  echo "switching at $n%"
}

cmd_current() { state_get '.active // empty'; }

cmd_rename() {
  local old=${1:-} new=${2:-} profile
  [ -n "$old" ] && [ -n "$new" ] || die "usage: claude-switch rename <old> <new>"
  require_account "$old"
  [ "$(state_get --arg n "$new" '.accounts[$n] == null')" = true ] || die "'$new' already exists"
  lock
  profile=$(kc_read "$STORE_SERVICE" "$old") || die "no saved account '$old'"
  kc_write "$STORE_SERVICE" "$new" "$profile"
  security delete-generic-password -s "$STORE_SERVICE" -a "$old" >/dev/null 2>&1 || true
  state_update '
    .accounts[$b] = .accounts[$a] | del(.accounts[$a])
    | (if .usage[$a] then .usage[$b] = .usage[$a] | del(.usage[$a]) else . end)
    | .order |= map(if . == $a then $b else . end)
    | (if .active == $a then .active = $b else . end)' --arg a "$old" --arg b "$new"
  echo "renamed '$old' to '$new'"
}

cmd_remove() {
  local name=${1:-}
  [ -n "$name" ] || die "usage: claude-switch remove <name>"
  require_account "$name"
  [ "$(state_get '.active // empty')" != "$name" ] || die "'$name' is active; switch first"
  security delete-generic-password -s "$STORE_SERVICE" -a "$name" >/dev/null 2>&1 || true
  state_update 'del(.accounts[$n], .usage[$n]) | .order -= [$n]' --arg n "$name"
  echo "removed '$name'"
}

usage() {
  cat <<EOF
claude-switch $VERSION - swap Claude Code subscription accounts on macOS

  add <name>     save the account you are logged in with
  add <name> --login  log in to another account in the browser and save it,
                 without switching or touching running sessions
  use <name>     switch to a saved account (logs in again if its token expired)
  next           switch to the next account that is not at its limit
  login <name>   log in again to a saved account (same isolated login)
  list           show accounts and usage (reads inactive accounts once)
  current        print the active account name
  threshold [n]  show or set the usage % that triggers a switch (default 95)
  rename <old> <new>  rename a saved account
  remove <name>  delete a saved account
  report         read status line JSON on stdin; switch when over the limit

Env: CLAUDE_SWITCH_THRESHOLD (default 95), CLAUDE_SWITCH_DIR (default ~/.claude-switch)
EOF
}

main() {
  command -v jq >/dev/null || die "jq is required"
  [ "$(uname)" = Darwin ] || die "macOS only"
  state_init
  # Env wins over the saved value, which wins over the default.
  THRESHOLD="${CLAUDE_SWITCH_THRESHOLD:-$(state_get '.threshold // 95')}"
  local cmd=${1:-help}
  shift || true
  case "$cmd" in
    add) cmd_add "$@" ;;
    use) cmd_use "$@" ;;
    next) cmd_next "$@" ;;
    login) cmd_login "$@" ;;
    list | ls | status) cmd_list ;;
    current) cmd_current ;;
    threshold) cmd_threshold "$@" ;;
    rename | mv) cmd_rename "$@" ;;
    remove | rm) cmd_remove "$@" ;;
    report) cmd_report ;;
    -v | --version) echo "$VERSION" ;;
    *) usage ;;
  esac
}

main "$@"
